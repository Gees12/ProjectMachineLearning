APP_NAME=DormInsight
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (XAMPP/Laragon). Buat database "dorminsight" terlebih dahulu.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dorminsight
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Jumlah penghuni Crystal Dormitory (untuk tingkat respons)
DORM_POPULATION=300

# Pendaftaran mandiri mahasiswa
DORM_REGISTRATION_ENABLED=true
DORM_REGISTRATION_REQUIRE_APPROVAL=true
# Contoh: unklab.ac.id (kosongkan untuk semua domain)
DORM_REGISTRATION_EMAIL_DOMAIN=

# ML service (FastAPI). ML_API_KEY harus sama dengan ml-service/.env
ML_SERVICE_URL=http://127.0.0.1:8001
ML_API_KEY=ganti-dengan-kunci-acak-panjang
ML_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"
